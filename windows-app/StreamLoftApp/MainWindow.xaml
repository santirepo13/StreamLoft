<Window x:Class="StreamLoftApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamLoft" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="StreamLoft" FontSize="20" FontWeight="Bold"/>
            <Button Content="Logout" Width="80" Height="30" Margin="20,0,0,0" Click="Logout_Click"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" Margin="10">
            <StackPanel>
                <TextBlock Text="Stream Information" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBlock Text="RTMP URL:" Margin="0,5,0,2"/>
                <TextBox Text="rtmp://172.86.73.79/live" IsReadOnly="True"/>
                <TextBlock Text="Stream Key:" Margin="0,5,0,2"/>
                <TextBox Text="[Your Stream Key]" IsReadOnly="True"/>
                
                <TextBlock Text="Destinations" FontSize="16" FontWeight="Bold" Margin="0,20,0,5"/>
                <!-- TODO: Add destination controls here -->
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Status:" VerticalAlignment="Center"/>
            <TextBlock Text="Offline" Foreground="Red" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
