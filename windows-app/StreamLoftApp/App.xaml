<Application x:Class="StreamLoftApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StreamLoftApp.Converters"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:LiveStatusBackgroundConverter x:Key="LiveStatusBackgroundConverter"/>
        <converters:ConfiguredBackgroundConverter x:Key="ConfiguredBackgroundConverter"/>
        <converters:ConfiguredTextConverter x:Key="ConfiguredTextConverter"/>
        <converters:ConfiguredStatusConverter x:Key="ConfiguredStatusConverter"/>
        <converters:ConfiguredStatusForegroundConverter x:Key="ConfiguredStatusForegroundConverter"/>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
    </Application.Resources>
</Application>