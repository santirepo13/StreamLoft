<Window x:Class="StreamLoftApp.Views.WelcomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome - StreamLoft" Height="560" Width="640"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Welcome"
                   Style="{StaticResource DarkPageTitleStyle}"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,30"/>

        <Border Grid.Row="1"
                Background="{StaticResource ColorSectionBg}"
                CornerRadius="10"
                Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding UserName}"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource HelperTextStyle}"
                           FontSize="16">
                    <Run Text="ID: "/>
                    <Run Text="{Binding NumericId}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="Proceed to Dashboard"
                    Command="{Binding ProceedCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="180" Height="40"
                    Margin="0,0,15,0"/>

            <Button Content="Logout"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
