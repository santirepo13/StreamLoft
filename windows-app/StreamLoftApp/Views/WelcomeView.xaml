<Window x:Class="StreamLoftApp.Views.WelcomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome - StreamLoft" Height="560" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#272757">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Text="Welcome" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#0F0E47"
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,30"/>
        
        <!-- User Info -->
        <Border Grid.Row="1" 
                Background="#505081" 
                CornerRadius="10" 
                Padding="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding UserName}" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <TextBlock HorizontalAlignment="Center"
                           Foreground="#8686AC"
                           FontSize="16">
                    <Run Text="ID: "/>
                    <Run Text="{Binding NumericId}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">
            
            <Button Content="Proceed to Dashboard" 
                    Command="{Binding ProceedCommand}"
                    Width="180" 
                    Height="40"
                    Background="#8686AC"
                    Foreground="#0F0E47"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"
                    Margin="0,0,15,0"/>
            
            <Button Content="Logout" 
                    Command="{Binding LogoutCommand}"
                    Width="100" 
                    Height="40"
                    Background="#505081"
                    Foreground="#FFFFFF"
                    FontSize="14"
                    Cursor="Hand"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>