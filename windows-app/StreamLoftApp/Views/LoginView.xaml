<Window x:Class="StreamLoftApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamLoftApp.Views.Controls"
        Title="StreamLoft Login" Height="560" Width="640"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="StreamLoft"
                   Style="{StaticResource DarkPageTitleStyle}"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,30"/>

        <Border Grid.Row="1"
                Style="{StaticResource SectionBorderStyle}"
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="User ID"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UserIdTextBox"
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         Width="250" Height="35"
                         FontSize="14"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120" Height="40"
                        Margin="0,25,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Enter your numeric user ID"
                   Style="{StaticResource HelperTextStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>

        <controls:LoadingOverlay Grid.RowSpan="3"
                                  IsVisible="{Binding IsLoading}"
                                  Message="Logging in..." />
    </Grid>
</Window>
