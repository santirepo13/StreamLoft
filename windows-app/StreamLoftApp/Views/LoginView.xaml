<Window x:Class="StreamLoftApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamLoft Login" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#272757">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Text="StreamLoft" 
                   FontSize="32" 
                   FontWeight="Bold" 
                   Foreground="#0F0E47"
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,30"/>
        
        <!-- Login Form -->
        <Border Grid.Row="1" 
                Background="#505081" 
                CornerRadius="10" 
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="User ID" 
                           Foreground="#FFFFFF" 
                           FontSize="14" 
                           Margin="0,0,0,8"/>
                
                <TextBox x:Name="UserIdTextBox" 
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Width="250" 
                         Height="35"
                         FontSize="14"
                         Padding="8"
                         Background="#8686AC"
                         Foreground="#0F0E47"
                         BorderThickness="0"/>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFA500"
                           FontSize="12"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- Login Button -->
                <Button Content="Login" 
                        Command="{Binding LoginCommand}"
                        Width="120" 
                        Height="40"
                        Margin="0,25,0,0"
                        Background="#8686AC"
                        Foreground="#0F0E47"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"/>
                
                <!-- Loading -->
                <TextBlock Text="Logging in..." 
                           Foreground="#FFFFFF"
                           FontSize="12"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
        
        <!-- Footer -->
        <TextBlock Grid.Row="2" 
                   Text="Enter your numeric user ID" 
                   FontSize="12" 
                   Foreground="#8686AC" 
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>