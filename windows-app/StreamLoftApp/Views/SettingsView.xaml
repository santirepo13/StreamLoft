<Window x:Class="StreamLoftApp.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - StreamLoft" Height="400" Width="500"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   Style="{StaticResource PageTitleStyle}"
                   FontSize="22"
                   Margin="0,0,0,25"/>

        <Border Grid.Row="1"
                Background="{StaticResource ColorSectionBg}"
                CornerRadius="10"
                Padding="20">
            <StackPanel>
                <!-- RTMP URL -->
                <TextBlock Text="StreamLoft RTMP URL"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RtmpUrlTextBox"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             Height="36"
                             FontSize="12"/>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Click="CopyRtmpUrl_Click"
                            Style="{StaticResource SmallDarkButtonStyle}"
                            Width="60"
                            Margin="5,0,0,0"/>
                </Grid>

                <!-- Stream Key -->
                <TextBlock Text="StreamLoft Stream Key"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StreamKeyTextBox"
                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                             Height="36"
                             FontSize="12"/>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Click="CopyStreamKey_Click"
                            Style="{StaticResource SmallDarkButtonStyle}"
                            Width="60"
                            Margin="5,0,0,0"/>
                </Grid>

                <!-- Upload Bitrate -->
                <TextBlock Text="Upload Bitrate"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BitrateTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Height="36"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="kbps"
                               Foreground="{StaticResource ColorWhiteText}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,10,0"/>
                    <Button Grid.Column="2"
                            Content="Set"
                            Click="SetBitrate_Click"
                            Style="{StaticResource SmallDarkButtonStyle}"
                            Width="50"
                            Height="36"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Content="Close"
                Click="Close_Click"
                Style="{StaticResource SecondaryButtonStyle}"
                Width="100" Height="36"
                Margin="0,25,0,0"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
