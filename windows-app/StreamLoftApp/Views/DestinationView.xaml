<Window x:Class="StreamLoftApp.Views.DestinationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamLoftApp.Views.Controls"
        Title="Configure Destination - StreamLoft" Height="640" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#272757">
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Configure Destination" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#0F0E47"/>
            <TextBlock Text="{Binding DestinationName}" 
                       FontSize="16" 
                       Foreground="#8686AC"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Input Form -->
        <Border Grid.Row="1" 
                Background="#505081" 
                CornerRadius="10" 
                Padding="20">
            <StackPanel>
                <TextBlock Text="Stream Key" 
                           Foreground="#FFFFFF" 
                           FontSize="14" 
                           Margin="0,0,0,10"/>
                
                <TextBox Text="{Binding StreamKeyInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="350"
                         Height="40"
                         FontSize="14"
                         Padding="10"
                         Background="#8686AC"
                         Foreground="#0F0E47"
                         BorderThickness="0"/>
                
                <TextBlock Text="Enter the stream key from your external streaming platform (YouTube, Twitch, Facebook, etc.)"
                           Foreground="#FFFFFF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
                
                <!-- Bitrate Limited -->
                <CheckBox Content="Bitrate Limited"
                          IsChecked="{Binding BitLimited}"
                          Foreground="#FFFFFF"
                          FontSize="14"
                          Margin="0,15,0,0"/>
                
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFA500"
                           FontSize="12"
                           Margin="0,15,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- Saved Indicator -->
                <TextBlock Text="✓ Stream key saved"
                           Foreground="#00FF00"
                           FontSize="12"
                           Margin="0,15,0,0"
                           Visibility="{Binding ShowSavedIndicator, Converter={StaticResource BoolToVisibilityConverter}}"/>
                
                <!-- Configured Status -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Status: " Foreground="#FFFFFF" FontSize="12"/>
                    <TextBlock Text="{Binding IsConfigured, Converter={StaticResource ConfiguredStatusConverter}}"
                               FontSize="12"
                               Foreground="{Binding IsConfigured, Converter={StaticResource ConfiguredStatusForegroundConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">
            
            <Button Content="Save" 
                    Command="{Binding SaveCommand}"
                    Width="120" 
                    Height="40"
                    Background="#8686AC"
                    Foreground="#0F0E47"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"
                    Margin="0,0,15,0"/>
            
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Width="100" 
                    Height="40"
                    Background="#505081"
                    Foreground="#FFFFFF"
                    FontSize="14"
                    Cursor="Hand"
                    BorderThickness="0"/>
        </StackPanel>
        
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="3"
                                 IsVisible="{Binding IsSaving}"
                                 Message="Saving..." />
    </Grid>
</Window>