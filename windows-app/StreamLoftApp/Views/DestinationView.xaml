<Window x:Class="StreamLoftApp.Views.DestinationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamLoftApp.Views.Controls"
        Title="Configure Destination - StreamLoft" Height="640" Width="720"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Configure Destination"
                       Style="{StaticResource DarkPageTitleStyle}"
                       FontSize="22"/>
            <TextBlock Text="{Binding DestinationName}"
                       Style="{StaticResource HelperTextStyle}"
                       FontSize="16"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Input Form -->
        <Border Grid.Row="1"
                Background="{StaticResource ColorSectionBg}"
                CornerRadius="10"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Stream Key"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,10"/>

                <TextBox Text="{Binding StreamKeyInput, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"
                         Width="350" Height="40"
                         FontSize="14"
                         Padding="10"/>

                <TextBlock Text="Enter the stream key from your external streaming platform (YouTube, Twitch, Facebook, etc.)"
                           Style="{StaticResource FormLabelStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>

                <CheckBox Content="Bitrate Limited"
                          IsChecked="{Binding BitLimited}"
                          Foreground="{StaticResource ColorWhiteText}"
                          FontSize="14"
                          Margin="0,15,0,0"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorTextStyle}"
                           Margin="0,15,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <TextBlock Text="✓ Stream key saved"
                           Foreground="{StaticResource ColorSuccess}"
                           FontSize="12"
                           Margin="0,15,0,0"
                           Visibility="{Binding ShowSavedIndicator, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Status: " Foreground="{StaticResource ColorWhiteText}" FontSize="12"/>
                    <TextBlock Text="{Binding IsConfigured, Converter={StaticResource ConfiguredStatusConverter}}"
                               FontSize="12"
                               Foreground="{Binding IsConfigured, Converter={StaticResource ConfiguredStatusForegroundConverter}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120" Height="40"
                    Margin="0,0,15,0"/>

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Height="40"/>
        </StackPanel>

        <controls:LoadingOverlay Grid.RowSpan="3"
                                  IsVisible="{Binding IsSaving}"
                                  Message="Saving..." />
    </Grid>
</Window>
