<Window x:Class="StreamLoftApp.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamLoftApp.Views.Controls"
        Title="Dashboard - StreamLoft" Height="576" Width="768"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="StreamLoft Dashboard"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="24"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding UserName}"
                       FontSize="14"
                       Cursor="Hand"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource ColorWhiteText}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ColorSuccess}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Settings" Command="{Binding SettingsCommand}"/>
                        <MenuItem Header="Events" Command="{Binding EventsCommand}"/>
                        <MenuItem Header="Logout" Command="{Binding LogoutCommand}"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
        </Grid>



        <!-- Destinations Section -->
        <Border Grid.Row="1"
                Background="{StaticResource ColorSectionBg}"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Destinations"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="18"
                           Margin="0,0,0,15"/>

                <!-- Destinations List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Destinations}"
                         Style="{StaticResource TransparentListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource ColorInputBg}"
                                    Padding="15" Margin="0,5"
                                    CornerRadius="8"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ColorDarkText}"/>
                                        <TextBlock Text="{Binding RtmpUrl}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ColorWhiteText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                     <Border Grid.Column="1"
                                             CornerRadius="10"
                                             Padding="10,5"
                                             Background="{Binding IsActive, Converter={StaticResource ConfiguredBackgroundConverter}}"
                                             Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.DestinationBadgeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource ConfiguredTextConverter}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ColorDarkText}"/>
                                    </Border>
                                </Grid>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.DestinationClickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="3"
                                  IsVisible="{Binding IsLoading}"
                                  Message="Loading..." />
    </Grid>
</Window>
