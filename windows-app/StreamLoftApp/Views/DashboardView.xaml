<Window x:Class="StreamLoftApp.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StreamLoftApp.Views.Controls"
        Title="Dashboard - StreamLoft" Height="576" Width="768"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="StreamLoft Dashboard"
                       Style="{StaticResource PageTitleStyle}"
                       FontSize="24"/>

            <Button Grid.Column="1"
                    Content="Logout"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="80" Height="30"
                    FontSize="12"/>
        </Grid>

        <!-- Stream Info Panel -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionBorderStyle}"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- RTMP URL -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="StreamLoft RTMP URL"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding RtmpUrl, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                        <Button Grid.Column="1"
                                Content="Copy"
                                Command="{Binding CopyRtmpUrlCommand}"
                                Style="{StaticResource SmallDarkButtonStyle}"
                                Width="60"
                                Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Stream Key -->
                <StackPanel Grid.Column="1" Margin="15,0,15,0">
                    <TextBlock Text="StreamLoft Stream Key"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding StreamKey, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                        <Button Grid.Column="1"
                                Content="Copy"
                                Command="{Binding CopyStreamKeyCommand}"
                                Style="{StaticResource SmallDarkButtonStyle}"
                                Width="60"
                                Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>

                 <!-- Status Indicator -->
                 <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                     <TextBlock Text="Status"
                                Style="{StaticResource FormLabelStyle}"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"/>
                     <Border CornerRadius="15"
                             Padding="15,5"
                             Background="{Binding IsLive, Converter={StaticResource LiveStatusBackgroundConverter}}">
                         <TextBlock Text="{Binding StatusText}"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="{StaticResource ColorDarkText}"/>
                     </Border>
                     <TextBlock Text="⚠ Low Bitrate"
                                Foreground="{StaticResource ColorWarning}"
                                FontSize="11"
                                Margin="0,5,0,0"
                                Visibility="{Binding BitrateWarning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                 </StackPanel>

                 <!-- Bitrate Setter -->
                 <StackPanel Grid.Column="3" HorizontalAlignment="Right" Margin="15,0,0,0">
                     <TextBlock Text="Upload Bitrate"
                                Style="{StaticResource FormLabelStyle}"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"/>
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="80"/>
                             <ColumnDefinition Width="Auto"/>
                         </Grid.ColumnDefinitions>
                         <TextBox Text="{Binding ConfiguredBitrate, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  Style="{StaticResource InputTextBoxStyle}"
                                  VerticalContentAlignment="Center"/>
                         <Button Grid.Column="1"
                                 Content="Set"
                                 Command="{Binding UpdateBitrateCommand}"
                                 Style="{StaticResource SmallDarkButtonStyle}"
                                 Width="50"
                                 Margin="5,0,0,0"/>
                     </Grid>
                     <TextBlock Text="kbps"
                                Foreground="{StaticResource ColorWhiteText}"
                                FontSize="11"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"/>
                 </StackPanel>
            </Grid>
        </Border>

        <!-- Destinations Section -->
        <Border Grid.Row="2"
                Style="{StaticResource SectionBorderStyle}"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Destinations"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="18"/>

                    <Button Content="View Events"
                            Command="{Binding EventsCommand}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            Width="100" Height="28"/>
                </Grid>

                <!-- Destinations List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Destinations}"
                         Style="{StaticResource TransparentListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ColorDarkText}"/>
                                        <TextBlock Text="{Binding RtmpUrl}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ColorWhiteText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            CornerRadius="10"
                                            Padding="10,5"
                                            Background="{Binding IsActive, Converter={StaticResource ConfiguredBackgroundConverter}}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.DestinationBadgeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource ConfiguredTextConverter}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ColorDarkText}"/>
                                    </Border>
                                </Grid>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.DestinationClickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="4"
                                  IsVisible="{Binding IsLoading}"
                                  Message="Loading..." />
    </Grid>
</Window>
